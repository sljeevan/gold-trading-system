# ==============================================================================
# 🏆 Institutional Gold Trading System Configuration
# ==============================================================================

# Execution Engine Mode:
#   "paper"   -> Simulated local SQLite paper broker (risk-free, zero broker needed)
#   "socket"  -> Free 100% Open-Source Native Socket Bridge EA (Zero fees, Linux/Mac/Windows)
#   "xm_mt5"  -> Native MetaTrader 5 Python connector (Windows / Windows VPS)
#   "metaapi" -> MetaAPI Cloud REST Gateway (Paid Cloud Subscription)
BROKER_MODE=socket

# Active XM Environment: "demo" | "live" (safeguard: defaults to demo)
XM_ACCOUNT_TYPE=demo

# Risk & Strategy Defaults
DEFAULT_SYMBOL=XAUUSD
DEFAULT_RISK_PER_TRADE_PCT=1.0
DEFAULT_TIMEFRAME=1h
DEFAULT_MAX_SPREAD_PIPS=3.5

# ==============================================================================
# 1. FREE OPEN-SOURCE MT5 SOCKET BRIDGE (Option 3 - $0 Monthly Cost)
# ==============================================================================
# Runs GoldTraderBridge.mq5 on XM MT5 (Windows/VPS/Wine) & listens on TCP port
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8888
MT5_BRIDGE_TIMEOUT=5.0

# ==============================================================================
# 2. XM NATIVE METATRADER 5 CREDENTIALS (Windows / Windows VPS)
# ==============================================================================
# Demo Account Profile
XM_DEMO_LOGIN=12345678
XM_DEMO_PASSWORD=your_demo_password
XM_DEMO_SERVER=XMGlobal-MT5

# Live Account Profile (⚠️ REAL CAPITAL)
XM_LIVE_LOGIN=87654321
XM_LIVE_PASSWORD=your_live_password
XM_LIVE_SERVER=XMGlobal-MT5

# ==============================================================================
# 3. METAAPI CLOUD GATEWAY CREDENTIALS (Paid Cloud Alternative)
# ==============================================================================
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_DEMO_ACCOUNT_ID=your_metaapi_demo_account_id
METAAPI_LIVE_ACCOUNT_ID=your_metaapi_live_account_id

# ==============================================================================
# 4. PAPER TRADING DATABASE
# ==============================================================================
PAPER_DB_PATH=~/.gold_trading_data/paper_trading.db
